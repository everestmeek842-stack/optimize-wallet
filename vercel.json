{
  "version": 2,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/explorer", "destination": "/explorer-workspace.html" },
    { "source": "/explorer/", "destination": "/explorer-workspace.html" },
    { "source": "/login", "destination": "/auth-login.html" }
  ]
}
