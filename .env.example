# ==========================================================
# Nexus Platform production environment template
# Copy this file to .env and fill in your own live values.
# ==========================================================

PORT=4000
APP_ENV=production
APP_NAME="Nexus Platform"
FRONTEND_URL="https://your-frontend.vercel.app"
BACKEND_URL="https://your-backend.onrender.com"
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# Master treasury wallet
MASTER_WALLET_ADDRESS="5uYJ3iVSCnCTVA7Nfr25JTCmE8LPyaAziCNGi1P55DRL"
MASTER_WALLET_NETWORK="solana"
MASTER_WALLET_RPC_URL="https://api.mainnet-beta.solana.com"

# Blockchain / wallet providers
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
PHANTOM_APP_URL="https://phantom.app"
USDT_MINT="Es9vMfrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB"

# AI providers
GEMINI_API_KEY="your-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# Billing / payouts

STRIPE_SECRET_KEY=""
PAYOUT_BATCH_INTERVAL_MINUTES=15
CLAIM_FEE_PERCENT=1.5
INSTANT_CLAIM_PREMIUM_PERCENT=3.0

# Security / admin
ADMIN_API_KEY="your-admin-api-key"
API_KEY_PEPPER="generate-a-long-random-server-side-secret"
SESSION_SECRET="your-session-secret"
LOG_LEVEL="info"

# Optional runtime flags
ENABLE_TELEGRAM_ALERTS=true
ENABLE_SUPABASE=true
ENABLE_MASTER_WALLET=true
